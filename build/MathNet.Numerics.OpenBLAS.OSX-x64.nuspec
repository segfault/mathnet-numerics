<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>MathNet.Numerics.OpenBLAS.OSX-x64</id>
    <version>@build.number@</version>
    <title>Math.NET Numerics - OpenBLAS Native Provider for macOS (x64)</title>
    <authors>Kuan Bartel, Christoph Ruegg, Marcus Cuda</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <icon>icon.png</icon>
    <projectUrl>https://numerics.mathdotnet.com/</projectUrl>
    <repository type="git" url="https://github.com/mathnet/mathnet-numerics" />
    <description>OpenBLAS native provider for Math.NET Numerics on macOS (x64).</description>
    <summary>OpenBLAS native provider for Math.NET Numerics on macOS (x64).</summary>
    <releaseNotes>@releaseNotes@</releaseNotes>
    <copyright>Copyright Math.NET Project</copyright>
    <tags>math numeric statistics probability integration interpolation linear algebra matrix fft native openblas</tags>
    @dependencies@
  </metadata>
  <files>
    <file src="../../out/OpenBLAS/OSX/x64/libMathNetNumericsOpenBLAS.dylib" target="runtimes/osx-x64/native/libMathNetNumericsOpenBLAS.dylib" />
    <file src="../../build/NativeProvider.targets" target="build/net461/MathNet.Numerics.OpenBLAS.OSX-x64.targets" />
    <file src="../../build/NativeProvider.targets" target="build/net48/MathNet.Numerics.OpenBLAS.OSX-x64.targets" />
    <file src="../../build/NativeProvider.targets" target="buildTransitive/net461/MathNet.Numerics.OpenBLAS.OSX-x64.targets" />
    <file src="../../build/NativeProvider.targets" target="buildTransitive/net48/MathNet.Numerics.OpenBLAS.OSX-x64.targets" />
    <file src="../../build/icon.png" target="icon.png" />
  </files>
</package>
